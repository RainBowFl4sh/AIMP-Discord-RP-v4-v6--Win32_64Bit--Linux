; Discord Rich Presence for AIMP - English texts (the reference for all other languages)
;
; New language: copy this file to "Langs\<language>.lng" in the plugin folder (next to aimp_discord_rpc.dll),
; set Name / Code / Aliases in [FILE] and translate the texts after "=". %1 and %2 are filled in by the plugin.
; Aliases: words that identify AIMP's language of the same name (file name, English / own name, code, LCID).
; A file with the Code of a built-in language (en, de, ru, uk) corrects single texts of that language.
[FILE]
Name=English
Code=en
Aliases=english;eng;en;1033

[DiscordRPC]
Tab.General=General
Tab.Display=Display
Tab.Cover=Cover art
Tab.Sources=Sources
Tab.Advanced=Advanced
Tab.About=About

Gen.Enable=Enable Discord Rich Presence
Gen.ActivityType=Activity type:
Gen.TypeListening=Listening (shows a progress bar)
Gen.TypePlaying=Playing (elapsed time only)
Gen.StatusText=Discord status text shows:
Gen.StatusApp=Activity name (AIMP/custom)
Gen.StatusState=Artist (second line)
Gen.StatusDetails=Track title (first line)
Gen.AppName=Name instead of "AIMP":
Gen.Timestamps=Show progress bar / elapsed time
Gen.Paused=When paused:
Gen.PausedShow=Show "Paused" status
Gen.PausedHide=Hide (PreMiD / other activity shows)
Gen.ClearAfter=Remove the presence after a pause of (min, 0 = never):
Gen.HideStreams=Hide presence for internet radio / streams
Gen.ExcludePaths=Hide presence when the file path contains (separate with ;):
Gen.Status=Status: %1

Disp.Details=First line:
Disp.State=Second line:
Disp.LargeText=Cover tooltip:
